{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tax-agent.local/schemas/draft-opinion.schema.json",
  "title": "DraftOpinion",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "case_version", "tax_date", "review_date", "status", "conclusion", "legal_issues", "calculation", "alternatives", "risks", "expert_questions", "unresolved_items"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "case_version": {"type": "integer", "minimum": 1},
    "tax_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["COMPLETE", "INCOMPLETE"]},
    "conclusion": {"type": "string", "minLength": 1},
    "legal_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "official_source", "analysis", "certainty"],
        "properties": {
          "issue": {"type": "string", "minLength": 1},
          "official_source": {"$ref": "common-definitions.schema.json#/$defs/official_source"},
          "analysis": {"type": "string", "minLength": 1},
          "certainty": {"type": "string", "enum": ["CLEAR", "INTERPRETIVE", "UNRESOLVED"]}
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "legal_parameters", "formulas", "intermediate_values", "results", "verification"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "value_krw", "source"],
            "properties": {"name": {"type": "string", "minLength": 1}, "value_krw": {"type": "string", "pattern": "^-?[0-9]+$"}, "source": {"type": "string", "minLength": 1}}
          }
        },
        "legal_parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "value", "effective_date", "source_id"],
            "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "effective_date": {"type": "string", "format": "date"}, "source_id": {"type": "string", "minLength": 1}}
          }
        },
        "formulas": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "intermediate_values": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value_krw"], "properties": {"name": {"type": "string", "minLength": 1}, "value_krw": {"type": "string", "pattern": "^-?[0-9]+$"}}}},
        "results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value_krw"], "properties": {"name": {"type": "string", "minLength": 1}, "value_krw": {"type": "string", "pattern": "^-?[0-9]+$"}}}},
        "verification": {"type": "string", "minLength": 1}
      }
    },
    "alternatives": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scenario", "assumptions", "result_krw"], "properties": {"scenario": {"type": "string", "minLength": 1}, "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "result_krw": {"type": "string", "pattern": "^-?[0-9]+$"}}}},
    "risks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["risk_id", "severity", "description", "human_review_required"], "properties": {"risk_id": {"type": "string", "minLength": 1}, "severity": {"type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR", "NOTE"]}, "description": {"type": "string", "minLength": 1}, "human_review_required": {"type": "boolean"}}}},
    "expert_questions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unresolved_items": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
