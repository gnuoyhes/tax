{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tax-agent.local/schemas/response-matrix.schema.json",
  "title": "ResponseMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "case_version",
    "tax_date",
    "review_date",
    "revision_cycle",
    "responses"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "case_version": {"type": "integer", "minimum": 1},
    "tax_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "revision_cycle": {"type": "integer", "minimum": 1, "maximum": 2},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "disposition", "modification", "additional_evidence", "remaining_uncertainty"],
        "properties": {
          "review_id": {"type": "string", "pattern": "^R-[0-9]{3}$"},
          "disposition": {"type": "string", "enum": ["ACCEPT", "PARTIAL_ACCEPT", "REJECT", "NEED_EVIDENCE"]},
          "modification": {"type": "string", "minLength": 1},
          "additional_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "remaining_uncertainty": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
